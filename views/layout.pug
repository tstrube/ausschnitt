doctype html
//- Dark only - Bootstrap's dark theme, on a black page (css/dark.css).
html(data-bs-theme='dark')
    head
        title Ausschnitt
        meta(charset='UTF-8')
        meta(name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover')
        meta(name='theme-color' content='#212529')
        link(rel='icon' type='image/svg+xml' href='/favicon.svg')
        //- Installable app (PWA) - see public/manifest.webmanifest and public/sw.js.
        link(rel='manifest' href='/manifest.webmanifest')
        link(rel='apple-touch-icon' href='/icons/apple-touch-icon.png')
        meta(name='apple-mobile-web-app-title' content='Ausschnitt')
        meta(name='apple-mobile-web-app-capable' content='yes')
        meta(name='mobile-web-app-capable' content='yes')
        //- The page draws behind the status bar itself - see css/status-bar.css.
        meta(name='apple-mobile-web-app-status-bar-style' content='black-translucent')
        meta(name='color-scheme' content='dark')
        link(rel='stylesheet' href='/vendor/bootstrap/bootstrap.min.css')
        link(rel='stylesheet' href='/css/dark.css')
        link(rel='stylesheet' href='/css/toast.css')
        link(rel='stylesheet' href='/css/buttons.css')
        link(rel='stylesheet' href='/css/status-bar.css')
        block head
    body
        //- Holds the iOS status bar's color - see css/status-bar.css.
        .status-bar-backdrop(aria-hidden='true')
        script(src='/js/toast.js')
        script(src='/js/pwa.js')
        block body
            nav.navbar.navbar-dark.bg-dark.mb-4
                .container-fluid
                    .d-flex.gap-2.align-items-center
                        a.btn.btn-outline-light.btn-icon(href='/' aria-label='Home' title='Home') 🏠
                        a.btn.btn-outline-light.btn-icon(href='/bookmarks' aria-label='Bookmarks' title='Bookmarks') 🔖
                    .d-flex.gap-2.align-items-center
                        include includes/account-buttons
                        a.btn.btn-outline-light.btn-icon(href='/settings' aria-label='Settings' title='Settings') ⚙
                        a.btn.btn-outline-light.btn-icon(href='/manual' aria-label='Manual' title='Manual') ❓
            .container
                block content

extends layout

block content
    h1 Comic List

    a.btn.btn-primary.mb-3(href='/add') + Add Comic

    if comics.length
        ul.list-group
            each comic in comics
                li.list-group-item.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
                    //- data-direction: which way the loading spinner turns (js/pageLoading.js).
                    a.flex-grow-1(href=comic.selector_image ? `/reader/${comic.id}` : `/select/${comic.id}` data-direction=comic.reading_direction)
                        div #{comic.title}
                        span.text-muted.small #{usageByComic[comic.id]} used
                    //- New pages found since this account last opened the
                    //- comic: opens them like tapping their notification
                    //- (the comic's "Tapping a notification opens").
                    if withNewPages.has(comic.id)
                        a.btn.btn-sm.btn-primary(href=`/reader/${comic.id}/open/notification` data-direction=comic.reading_direction title='Open the new pages, as set under "Tapping a notification opens"') New ›
                    //- Clear and Delete are on the comic's Settings page.
                    a.btn.btn-sm.btn-outline-secondary(href=`/comics/${comic.id}/settings` title='Reading mode, notifications, history, ignored pages, Clear and Delete for this comic') Settings

    else
        p No comics yet.


extends layout

block head
    link(rel='stylesheet' href='/css/reader.css')

block body
    //- reader-rtl: the loading spinner turns counterclockwise, like the
    //- panels run.
    .reader-shell(class=comic.reading_direction === 'rtl' ? 'reader-rtl' : null)
        .reader-topbar
            .reader-topbar-group
                a.btn.btn-outline-light.btn-icon(href='/' aria-label='Home' title='Home') 🏠
                button#bookmarksBtn.btn.btn-outline-light.btn-icon(type='button' title='Bookmarks') 🔖
                button#historyBtn.btn.btn-outline-light.btn-icon(type='button' title='Resume history') 🕘
            .reader-topbar-group
                button#ignoreBtn.btn.btn-outline-light.btn-icon(type='button' title="Ignore this page (skips it during scrolling - undo right after, or later from this comic's Settings page)") 🚫
                a.btn.btn-outline-light.btn-icon(href=`/comics/${comic.id}/settings` aria-label='Comic settings' title="This comic's settings & ignored pages") ⚙
                a.btn.btn-outline-light.btn-icon(href='/manual' aria-label='Manual' title='Manual') ❓
        .reader-history-panel#bookmarksPanel
            strong.small Bookmarks
            form#saveBookmarkForm.d-flex.gap-1.mt-2.mb-2
                input.form-control.form-control-sm#bookmarkNameInput(type='text' placeholder='Bookmark name' required)
                button.btn.btn-sm.btn-primary(type='submit') Save
            ul#bookmarksList.list-unstyled.small
            a.small(href='/bookmarks') Manage all bookmarks →
        .reader-history-panel#historyPanel
            strong.small Resume history
            ul#historyList.list-unstyled.small
            //- The hidden bottom bar's First/Latest (readerScroll.js).
            if hideNav
                .d-flex.gap-3.small.mt-1.mb-1
                    button#historyFirstLink.btn.btn-link.btn-sm.p-0(type='button') ⏮ First page
                    button#historyLatestLink.btn.btn-link.btn-sm.p-0(type='button') ⏭ Newest page
            a.small(href='/manual#bookmarks') What's this? →
        //- The banner overlays the top of the feed: it toggles after position
        //- reports, mid-scroll, and must never move the panels.
        .reader-feed-area
            .reader-resume-banner#resumeBanner(class=atBookmark ? '' : 'visible')
                span Jumped away from your last spot.
                button#resumeBtn.btn.btn-sm.btn-light(type='button') Resume
                button#setBookmarkBtn.btn.btn-sm.btn-outline-light(type='button') Save Resume Point
            .reader-scroll-feed#scrollFeed
                .reader-scroll-spacer#topSpacer
                .reader-scroll-sentinel#topSentinel
                each panel in panels
                    img.reader-scroll-panel(src=panel.imageUrl, width=panel.width, height=panel.height, data-panel-id=panel.id, data-page-id=panel.pageId, alt='Comic panel')
                .reader-scroll-sentinel#bottomSentinel
            //- Over the feed, not in it: a jump can take a while (pages
            //- downloaded and split).
            .reader-loading#loadingIndicator
                .reader-spinner
        if !hideNav
            .reader-controls
                button#firstBtn.btn.btn-outline-light(aria-label='First page') ⏮
                button#latestBtn.btn.btn-outline-light(aria-label='Latest page') ⏭
        else if firstOpen
            //- The bottom bar's First/Latest, asked once: the first time
            //- this account opens the comic.
            .reader-start-dialog.visible#startDialog(role='dialog' aria-modal='true' aria-labelledby='startDialogTitle')
                .reader-start-dialog-box
                    strong#startDialogTitle Where do you want to start?
                    button#startFirstBtn.btn.btn-primary(type='button') ⏮ From the beginning
                    //- At the homepage that's where we already are.
                    button#startLatestBtn.btn.btn-outline-light(type='button' data-here=startIsHome ? 'true' : null) ⏭ Newest page
                    if !startIsHome
                        button#startStayBtn.btn.btn-link.btn-sm.text-light(type='button') Stay here

    script(src='/js/readerScroll.js')
    script.
        const comicId = !{comic.id};
        const comicTitle = !{JSON.stringify(comic.title)};
        const initialBookmarkHistory = !{JSON.stringify(bookmarkHistory)};
        const initialBookmarks = !{JSON.stringify(bookmarks)};
        const anchorPanelId = !{anchorPanelId};
        const initialAtBookmark = !{atBookmark ? 'true' : 'false'};
        const initialAtStart = !{atStart ? 'true' : 'false'};

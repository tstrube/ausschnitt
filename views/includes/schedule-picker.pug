//- Weekday toggles and a time for a new-page check schedule
//- (utils/schedule.ts). Posts notify_days (one value per checked day) and
//- notify_time; no day checked means "never".
mixin schedulePicker(schedule, idPrefix)
    .schedule-picker
        .btn-group.schedule-days(role='group' aria-label='Weekdays')
            each weekday in weekdays
                input.btn-check(type='checkbox' name='notify_days' value=weekday.day id=`${idPrefix}-day-${weekday.day}` autocomplete='off' checked=schedule.days.includes(weekday.day))
                label.btn.btn-sm.btn-outline-secondary(for=`${idPrefix}-day-${weekday.day}` title=weekday.label)= weekday.short
        input.form-control.form-control-sm.schedule-time(type='time' name='notify_time' id=`${idPrefix}-time` value=schedule.time aria-label='Time' required)

{
    "name": "ausschnitt",
    "version": "1.0.0",
    "private": true,
    "description": "Self-hosted webcomic reader that splits pages into panels for reading on small screens.",
    "keywords": [
        "webcomic",
        "comic-reader",
        "pwa",
        "self-hosted",
        "panel-detection"
    ],
    "author": "Timo Strube",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/tstrube/ausschnitt",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tstrube/ausschnitt.git"
    },
    "bugs": "https://github.com/tstrube/ausschnitt/issues",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "start": "node ./bin/www",
        "test": "tsc && cd dist && node --test"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^13.0.3",
        "bootstrap": "^5.3.8",
        "compression": "^1.7.5",
        "express": "^5.1.0",
        "express-session": "^1.19.0",
        "http-errors": "^2.0.0",
        "jsdom": "^30.1.3",
        "pug": "^3.0.3",
        "sharp": "^0.35.4",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/compression": "^1.7.5",
        "@types/express": "^5.0.1",
        "@types/express-session": "^1.18.0",
        "@types/http-errors": "^2.0.4",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24.19.2",
        "@types/web-push": "^3.6.4",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "better-sqlite3": false
    }
}
